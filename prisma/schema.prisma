datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING
  ACTIVE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus @default(PENDING)
  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  xp             Int       @default(0)
  level          Int       @default(1)
  lessonProgress LessonProgress[]
  streak         UserStreak?
  badges         UserBadge[]
  // Time-limited discount (see src/lib/offers.ts)
  offerCode      String?
  offerExpiresAt DateTime?
  offerSource    String?
  gameStates     GameState[]
  // Which marketing post brought them (src/lib/campaign.ts), from the aeo_utm cookie at sign-up
  signupSource   String?
  signupCampaign String?
  // Where they first came from (src/lib/referrer.ts, aeo_ref cookie at sign-up), and their own answer on the dashboard
  signupReferrer String?
  signupLanding  String?
  heardAbout     String?
  createdAt      DateTime  @default(now())
  // Nurture email sequence (src/lib/nurture.ts): enrollment time and opt-out
  nurtureStartedAt    DateTime?
  emailUnsubscribedAt DateTime?
  emailSends          EmailSend[]
  xpClaims            XpClaim[]
  certificate         Certificate?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  active           Boolean   @default(false)
  trial            Boolean   @default(false)
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// "lifetime" (one payment) or "monthly" (monthly pass); see src/lib/plans.ts
  plan                 String    @default("lifetime")
  stripeSubscriptionId String?   @unique
  /// For monthly: access runs to here (plus a short grace) even if a renewal is late
  currentPeriodEnd     DateTime?
}

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  started        Boolean  @default(false)
  bestScore      Int?
  completed      Boolean  @default(false)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  xpEarned       Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  criteria    String
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

/// Email addresses captured outside of account creation (newsletter box
/// and other sign-up forms). Kept here so the list outlives Resend's 30-day log.
model EmailLead {
  id        String   @id @default(cuid())
  email     String
  source    String
  name      String?
  createdAt DateTime @default(now())

  @@unique([email, source])
}

/// Per-user, per-game state blob (arbitrary per-game progress). Games keep a localStorage copy for guests and merge it
/// here on sign-in, so the shape of `state` is owned by the game module.
model GameState {
  id        String   @id @default(cuid())
  userId    String
  game      String
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
}

/// One browser landing on a tagged marketing link (src/lib/campaign.ts); one row per visitor per campaign.
model CampaignVisit {
  id        String   @id @default(cuid())
  visitorId String
  source    String
  medium    String
  campaign  String
  path      String
  createdAt DateTime @default(now())

  @@unique([visitorId, source, campaign])
  @@index([source, campaign])
}

/// One row per nurture email actually sent, so the daily cron never sends a
/// step twice. `key` is the step key from src/lib/nurture.ts.
model EmailSend {
  id     String   @id @default(cuid())
  userId String
  key    String
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// One row per XP-earning step a user has been paid for (src/lib/xp-claims.ts), so a
/// replayed claim (reload, second tab) pays nothing. `xp` is what the key paid; for
/// the `audit` key it is the best audit value so far, and a retake pays only the gain.
model XpClaim {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  key       String
  xp        Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, key])
}

// The course certificate (src/lib/certificate-issue.ts): one per learner, issued once every
// catalog lesson is complete. `code` is the public id in /verify/<code>; the name follows the
// account, the code and issue date never change.
model Certificate {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String   @unique
  name      String
  issuedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
