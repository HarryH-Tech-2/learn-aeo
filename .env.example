# Learn AEO environment variables. Copy to .env.local and fill in; never commit real values.
# Flags named *_ENABLED default to off when empty.
# Production: `node --env-file=<file> scripts/check-env.mjs` lists anything missing or wrong; a Vercel production build runs the same check and fails.

# --- Site ---
# Public site URL, no trailing slash. Defaults to https://www.learnaeo.com when empty.
NEXT_PUBLIC_SITE_URL=
# Base URL used in auth callbacks and email links (http://localhost:3000 locally).
NEXTAUTH_URL=
# Reply-to / owner notification address. Defaults to hello@learnaeo.com when empty.
CONTACT_TO_EMAIL=
# Comma-separated emails allowed into the admin pages.
ADMIN_EMAILS=
# Deployment environment, set by Vercel (production or preview).
VERCEL_ENV=

# --- Database ---
# Postgres: pooled connection string and direct one, read by prisma/schema.prisma.
POSTGRES_URL=
DATABASE_URL=

# --- Auth ---
# Random secret used to sign NextAuth sessions and tokens.
NEXTAUTH_SECRET=
# Google OAuth client credentials for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 in local dev only to skip sign-in (ignored in production).
AEO_DEV_BYPASS_AUTH=

# --- Stripe ---
# Secret API key for the Learn AEO Stripe account.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint.
STRIPE_WEBHOOK_SECRET=
# Price ids from scripts/stripe-create-plans.mjs: Lifetime ($100 / £80) and Monthly ($10 / £8 a month).
STRIPE_PRICE_ID=
STRIPE_PRICE_MONTHLY=

# --- Email ---
# Resend API key for transactional and nurture email.
RESEND_API_KEY=
# From address, e.g. hello@learnaeo.com.
RESEND_FROM_EMAIL=
# Resend audience id for newsletter sign-ups.
RESEND_AUDIENCE_ID=

# --- Cron and flags ---
# Bearer secret that protects /api/cron/* routes.
CRON_SECRET=
# true to send the nurture email sequence.
NURTURE_ENABLED=
# true to send post-purchase feedback requests.
PURCHASE_FEEDBACK_ENABLED=
# Percentage (0-100) of new visitors shown the free-unlock variant.
ACCESS_TEST_FREE_PERCENT=
# 1 lets a production build go up with settings still missing (a holding site before launch).
# Wrong or unsafe values still fail the build. Remove it before launch: scripts/check-env.mjs fails while it is set.
AEO_PRELAUNCH=

# --- Analytics ---
# GA4 measurement id (G-XXXXXXXXXX). GA is off when empty.
NEXT_PUBLIC_GA_ID=
# GA4 Measurement Protocol API secret for server-side purchase events.
GA4_MP_API_SECRET=
